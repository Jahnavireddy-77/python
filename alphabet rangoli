import string

def print_rangoli(size):
    letters = string.ascii_lowercase[:size]
    rows = []

    for i in range(size):
        left = letters[size-1:i:-1]
        right = letters[i:size]
        row = "-".join(left + right)
        rows.append(row.center(4 * size - 3, "-"))

    print("\n".join(rows[::-1] + rows[1:]))
if __name__ == '__main__':
    n = int(input())
    print_rangoli(n)
