from collections import OrderedDict
N = int(input())
items = OrderedDict()
for i in range(N):
    item_name, net_price = input().rsplit(' ', 1)
    net_price = int(net_price)
    if item_name in items:
        items[item_name] += net_price
    else:
        items[item_name] = net_price
for item, price in items.items():
    print(item, price)
